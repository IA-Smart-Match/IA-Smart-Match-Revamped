# SmartMatch local configuration.
#
# Copy to .env for local development. .env is gitignored and must never be
# committed — CI fails the build if one is tracked.
#
# No value here is a real credential. Every provider key is deliberately left
# empty: the Foundation scaffold runs on fixtures, and the live adapters are
# skeletons that refuse to initialize.

# dev | staging | classroom | production
# `classroom` is enforced, not advisory: the settings validator refuses to boot a
# classroom edition that has fixture providers disabled or that carries any
# provider credential at all.
SMARTMATCH_EDITION=dev

SMARTMATCH_DATABASE_URL=postgresql+psycopg://smartmatch:smartmatch@localhost:5432/smartmatch

# Always true in the Foundation scaffold. Setting it false does not enable live
# providers — it only causes provider construction to fail with an explicit
# error, because no live adapter is implemented yet.
SMARTMATCH_USE_FIXTURE_PROVIDERS=true

# Local pilot fixture identities only. JSON maps a pre-shared bearer token to a
# stable external subject. This is not real account authentication: it has no
# password, expiry, or revocation. Leave empty for the default all-401 fixture.
# Non-empty configuration is rejected in staging, classroom, and production, and
# it requires SMARTMATCH_USE_FIXTURE_PROVIDERS=true.
#
# Seed a matching synthetic account and server-assigned membership with:
# make migrate
# make seed-pilot SEED_PILOT_ARGS="--subject local-pilot-coordinator --email coordinator@example.test --role coordinator"
SMARTMATCH_DEV_PRINCIPALS={}

# Provider credentials. Left empty on purpose.
# In deployed environments these come from Secret Manager, never from a file.
# Outreach ships in R4 behind gate G4; the Routes adapter in R1 behind open
# decision 6.
SMARTMATCH_EMAIL_API_KEY=
SMARTMATCH_ROUTES_API_KEY=

# Shown in the health response so a deployment can be identified.
SMARTMATCH_RELEASE=dev

# -----------------------------------------------------------------------------
# Pilot login credentials (owner-supplied)
# -----------------------------------------------------------------------------
# The owner-authorized, PILOT-SCOPED substitute for institutional sign-in
# (docs/decisions/pilot-login-decision-2026-09-04.md). This is not A1b and does
# not unblock it: the JWKS verifier stays unwired and the IdP worksheet stays
# unfilled.
#
# Fill these in your own .env (gitignored, never committed) and run:
#   make migrate
#   make seed-pilot-logins
#
# One login per role, and the ROLE IS NOT PART OF THE LOGIN. The seed writes a
# `membership` row carrying the role; signing in only proves who you are, and
# `smartmatch_authz` decides what you may do from that row. The login form and
# `POST /v1/auth/login` accept an email and a password and reject any body that
# names a role, tenant, or unit.
#
# Behaviour when a pair is left blank, which is what these placeholders are:
#   - that role's account is NOT created, and the seed says so by name;
#   - no default password is invented and nothing is silently skipped;
#   - setting only one of a pair is an ERROR, not a half-configured login.
#
# The values below are placeholders. Replace BOTH halves of any pair you want,
# and leave the rest empty. Passwords must be at least 12 characters. Never
# commit a real one — CI's secret scan reads commit patches across every ref,
# and one leaked literal cannot be undone by a later commit.
#
# `student` matters specifically: the rewards catalog and redemption routes are
# gated on the `student` role alone, so no other login can demonstrate rewards.
SMARTMATCH_PILOT_COORDINATOR_EMAIL=
SMARTMATCH_PILOT_COORDINATOR_PASSWORD=
SMARTMATCH_PILOT_STUDENT_EMAIL=
SMARTMATCH_PILOT_STUDENT_PASSWORD=
SMARTMATCH_PILOT_ADMIN_EMAIL=
SMARTMATCH_PILOT_ADMIN_PASSWORD=
SMARTMATCH_PILOT_VOLUNTEER_EMAIL=
SMARTMATCH_PILOT_VOLUNTEER_PASSWORD=
