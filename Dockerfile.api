# SmartMatch API image — Foundation scaffold.
#
# Builds a runnable container for services/api. It does not deploy anything and
# nothing here is claimed to be production-ready: the migration contract sets
# ALLOW_CLOUD_DEPLOY=false, and image publication, scanning, and signing are
# before-scale gates (see the deferred-gate list at the bottom of
# .github/workflows/verify.yml). What this file provides is an artifact that can
# be built and run locally and in CI, so that the packaging is exercised rather
# than assumed.
#
# See docs/operations/containers.md for the reasoning in full, including why the
# dependency install is split into two steps and why the process is started
# through `sh -c ... exec`.

# ---------------------------------------------------------------------------
# Stage 1 — builder. Produces /opt/venv and is then discarded.
# ---------------------------------------------------------------------------
# python:3.11-slim-bookworm (Debian 12 "bookworm", CPython 3.11), pinned by
# digest. A tag is a moving pointer: `python:3.11-slim-bookworm` names a
# different image every few weeks, so a build pinned to the tag is not
# reproducible and a compromised or merely broken upstream rebuild is picked up
# silently. The tag stays in this comment because a bare digest is unreadable.
FROM python:3.11-slim-bookworm@sha256:2e32f7d302adc1c37428355c1e646897c0c53f4fd60b6a551245fb90ee129f91 AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_ROOT_USER_ACTION=ignore

# A virtualenv rather than the system interpreter's site-packages: it makes the
# whole dependency set one directory that the final stage can copy wholesale,
# which is what keeps the build toolchain out of the runtime image.
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

WORKDIR /src

# --- Step 1: third-party dependencies, hash-verified -----------------------
#
# requirements/runtime.txt, not dev.txt: the image needs FastAPI and psycopg,
# not pytest, mypy, and ruff. --require-hashes is the same control the
# repository already relies on in `make setup` and in CI (security finding
# S-003); an image that installed unpinned would be a hole in it, since the
# image is the artifact that would actually run.
COPY requirements/runtime.txt requirements/runtime.txt
RUN pip install --require-hashes -r requirements/runtime.txt

# --- Step 2: workspace packages, non-editable ------------------------------
#
# Deliberately a separate invocation. --require-hashes is an all-or-nothing
# mode: it demands a recorded hash for *every* requirement in the invocation,
# and a local source directory has no such hash — there is no published
# artifact to have hashed. Adding these paths to the command above therefore
# fails outright, and the only ways to make it pass are to drop the flag or to
# invent a hash, both of which would remove the control from the dependencies
# that do have one. Splitting the steps keeps hash verification intact where it
# is meaningful.
#
# --no-deps because the dependency set is already installed, exactly, above;
# letting pip resolve again could silently pull an unpinned, unverified
# replacement to satisfy `smartmatch-domain` or a version range.
#
# Non-editable (no -e): `make setup` installs these editable so local edits take
# effect immediately, which is a development affordance. An editable install is
# a .pth file pointing at a source tree; in an image that means the source tree
# has to ship too, and the installed package silently changes if anything
# mutates it. A shipped artifact should contain built packages.
COPY python/ python/
COPY services/api/ services/api/
RUN pip install --no-deps \
        python/smartmatch_domain \
        python/smartmatch_authz \
        python/smartmatch_providers \
        python/smartmatch_persistence \
        services/api

# Fail the build here rather than at container start if the application cannot
# be imported — a build that succeeds and produces an image that cannot boot is
# a green result that means nothing.
RUN python -c "import smartmatch_api.main"

# ---------------------------------------------------------------------------
# Stage 2 — runtime. Carries the virtualenv and nothing else.
# ---------------------------------------------------------------------------
FROM python:3.11-slim-bookworm@sha256:2e32f7d302adc1c37428355c1e646897c0c53f4fd60b6a551245fb90ee129f91 AS runtime

# PYTHONDONTWRITEBYTECODE is set here but *not* in the builder: pip compiles
# .pyc files during install, so they are baked into the copied virtualenv and
# startup does not pay to regenerate them. At run time the process owns none of
# that directory anyway, so any attempt to write bytecode would fail; disabling
# it avoids the noise.
# PYTHONUNBUFFERED so log lines reach the container's stdout as they happen
# rather than when a buffer fills, which is the difference between a useful log
# and a log that stops mid-incident.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:${PATH}"

# A fixed numeric uid/gid, not just a name: the numeric id is what the kernel
# and any mounted volume actually see, and pinning it makes file ownership
# predictable. 10001 is outside the range Debian hands out to system packages.
RUN groupadd --system --gid 10001 smartmatch \
 && useradd --system --uid 10001 --gid 10001 \
        --home-dir /home/smartmatch --create-home \
        --shell /usr/sbin/nologin smartmatch

# Copied as root:root on purpose. The application user can read and execute the
# virtualenv but cannot modify it, so a process compromise cannot rewrite an
# installed package and persist. The only directory the user owns is its home.
COPY --from=builder --chown=root:root /opt/venv /opt/venv

USER 10001:10001
WORKDIR /home/smartmatch
ENV HOME=/home/smartmatch

# Cloud Run injects PORT; nothing else should assume 8080. This is the default
# for a plain `docker run`, and it is overridden by the environment, not baked
# into the command line.
ENV PORT=8080
EXPOSE 8080

# No secrets, no .env, and no provider configuration are present in this image.
# Settings are read from SMARTMATCH_-prefixed environment variables at start-up
# (services/api/smartmatch_api/config.py), and the API's boot-time validation
# refuses to start a misconfigured classroom edition. Configuration arriving at
# run time is what allows the same image to be correct in more than one
# environment; configuration baked in at build time is what makes an image
# unsafe to move.

# Uses the interpreter already in the image rather than adding curl, which
# would enlarge the image and the attack surface to answer one HTTP request.
# Cloud Run does not read this; it is for `docker ps` and for local runs.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["python", "-c", "import os,sys,urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:%s/api/health' % os.environ.get('PORT','8080'), timeout=2).status == 200 else 1)"]

# Exec-form CMD invoking `sh -c ... exec`, which is not the same thing as
# shell-form CMD. Shell form runs `/bin/sh -c "uvicorn ..."` with the shell as
# PID 1; the shell does not forward signals, so SIGTERM on a rolling restart or
# a `docker stop` reaches the shell, uvicorn never hears it, and in-flight
# requests are killed when the grace period expires. The `exec` here replaces
# the shell with uvicorn, so uvicorn *is* PID 1 and receives SIGTERM directly
# and shuts down gracefully. The shell is still needed for one reason only:
# expanding ${PORT}, which exec form cannot do.
#
# No --reload (that is a development affordance and it also breaks signal
# handling), and no --workers: on Cloud Run, concurrency is a service setting
# and scaling is horizontal, so a second process per container competes for the
# same CPU allocation and doubles the connection pool for nothing.
CMD ["sh", "-c", "exec uvicorn smartmatch_api.main:app --host 0.0.0.0 --port \"${PORT:-8080}\""]
