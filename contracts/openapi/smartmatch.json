{
  "components": {
    "schemas": {
      "CommandAcceptedResponse": {
        "description": "Standard acknowledgement for every command resource.",
        "properties": {
          "events_url": {
            "title": "Events Url",
            "type": "string"
          },
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "replayed": {
            "default": false,
            "title": "Replayed",
            "type": "boolean"
          },
          "status": {
            "default": "accepted",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "events_url"
        ],
        "title": "CommandAcceptedResponse",
        "type": "object"
      },
      "ErrorBody": {
        "description": "The inner error object.",
        "properties": {
          "code": {
            "description": "Stable machine-readable code; safe to branch on",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional structured context",
            "title": "Details"
          },
          "message": {
            "description": "Human-readable summary; not for branching",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorEnvelope": {
        "description": "The response body for every non-2xx API response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "ImportRequest": {
        "description": "An import submission.\n\nDeliberately carries no tenant, actor, or timestamp. All three are derived\nserver-side; accepting them from the body is the caller-supplied-identity\npattern archived as MM-A01.",
        "properties": {
          "dataset": {
            "description": "Logical dataset name, e.g. 'professionals'",
            "maxLength": 100,
            "minLength": 1,
            "title": "Dataset",
            "type": "string"
          },
          "dry_run": {
            "default": true,
            "description": "When true the import validates and reports without creating review items. Defaults to true: the safe outcome should be the one you get by not thinking about it.",
            "title": "Dry Run",
            "type": "boolean"
          },
          "source_reference": {
            "description": "Opaque reference to previously uploaded content in Cloud Storage",
            "maxLength": 500,
            "minLength": 1,
            "title": "Source Reference",
            "type": "string"
          }
        },
        "required": [
          "source_reference",
          "dataset"
        ],
        "title": "ImportRequest",
        "type": "object"
      },
      "JobState": {
        "description": "Every state a durable job may occupy.",
        "enum": [
          "queued",
          "dispatched",
          "running",
          "succeeded",
          "partial",
          "failed_provider",
          "failed_budget",
          "failed_policy",
          "cancelled",
          "timed_out",
          "redrive_pending",
          "abandoned"
        ],
        "title": "JobState",
        "type": "string"
      },
      "JobStatusResponse": {
        "description": "A job's current state.",
        "properties": {
          "command_type": {
            "title": "Command Type",
            "type": "string"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "latest_sequence": {
            "default": 0,
            "description": "Highest job_event sequence emitted so far",
            "title": "Latest Sequence",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/JobState"
          },
          "updated_at": {
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "command_type",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "JobStatusResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "IA West SmartMatch platform API \u2014 Foundation scaffold. OpenAPI is the source of truth; the TypeScript client is generated from it and never hand-maintained.",
