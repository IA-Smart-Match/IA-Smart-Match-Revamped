    "/u/{token}": {
      "get": {
        "description": "Render the unsubscribe confirmation page. **Never changes state.**\n\nFixes the v1.0 mutating-GET unsubscribe (v1.1 \u00a71.10). A GET here is reached\nby link scanners, mail-client prefetchers, and security proxies; if it\nmutated, those would silently unsubscribe recipients who never clicked.\n\nThe actual unsubscribe is the signed POST, or the RFC 8058 one-click POST\nthat mail providers issue directly. Both arrive with R4.",
        "operationId": "unsubscribe_page_u__token__get",
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "title": "Token",
              "type": "string"
            }
          }
        ],
        "responses": {
