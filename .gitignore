# ---------------------------------------------------------------------------
# Secrets and credentials — never committed.
# The forbidden-legacy-behavior scan (tools/scan_forbidden.py) also fails the
# build if any of these appear in tracked files.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*-credentials.json
service-account*.json
gha-creds-*.json

# ---------------------------------------------------------------------------
# Local business persistence is prohibited by architecture v1.1 §"Forbidden
# legacy behavior". These patterns exist so an accidental local write is never
# committed; PostgreSQL is the only system of record.
# ---------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
data/feedback/
cache/
output/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node
node_modules/
apps/web/dist/
apps/web/.vite/
*.tsbuildinfo

# Terraform
# Nothing under infra/terraform has ever been applied, so none of these has
# ever existed in this repository. They are ignored so that the first person
# to run `terraform init` or a plan cannot commit one by accident: state and
# a plan file both contain resolved values, and a .tfvars is where a real
# project id would first be written down.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example

# Editors / OS
.DS_Store
.idea/
.vscode/
.claude/
*.swp

# Downloaded distribution artifacts. Dependencies are installed from the
# hash-pinned locks in requirements/, never from a wheel sitting in the tree —
# a committed wheel is an unreviewed binary that bypasses hash verification
# entirely. These appeared once already, downloaded into the repository root by
# tooling run with the wrong working directory.
*.whl
*.tar.gz

# Stakeholder working spreadsheets. The 19-20 August 2026 test log lives in
# docs/ as a local reference while its findings are worked through; the
# findings themselves belong in docs/plans/, in text a reviewer can diff.
# A binary spreadsheet in git is a file nobody can review a change to.
*.xlsx

# Codex CLI debris. `codex exec` writes an error.log into the working directory
# on startup; it carries the account identifier the CLI authenticated with, and
# it is a transcript of a tool run rather than anything about this project.
# Ignored rather than deleted-and-forgotten so a future run cannot stage it.
error.log
